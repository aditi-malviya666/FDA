# Include report directories, plots, and metric tables in version control.
!/reports/
!/reports/figures/
!/reports/figures/*.png
!/reports/metrics/
!/reports/metrics/*.csv

# Datasets and the slide deck are also intentionally not ignored.
# Check dataset redistribution rights before committing them.
